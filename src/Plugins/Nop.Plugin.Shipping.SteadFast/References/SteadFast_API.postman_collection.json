      "name": "Placing an Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Api-Key", "value": "{{Api-Key}}", "type": "text" },
          { "key": "Secret-Key", "value": "{{Secret-Key}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "url": { "raw": "{{baseUrl}}/create_order", "host": ["{{baseUrl}}"], "path": ["create_order"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"invoice\": \"12366\",\n  \"recipient_name\": \"John Smith\",\n  \"recipient_phone\": \"01234567890\",\n  \"recipient_address\": \"Fla# A1,House# 17/1, Road# 3/A, Dhanmondi,Dhaka-1209\",\n  \"cod_amount\": 1060,\n  \"note\": \"Deliver within 3PM\"\n}"
        }
      }
    },
