{
  "info": {
    "_postman_id": "b7e1e7e2-steadfast-api-collection",
    "name": "SteadFast Courier Limited API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "SteadFast Courier Limited API v1 - All endpoints with authentication headers."
  },
  "variable": [
    { "key": "baseUrl", "value": "https://portal.packzy.com/api/v1" },
    { "key": "Api-Key", "value": "YOUR_API_KEY" },
    { "key": "Secret-Key", "value": "YOUR_SECRET_KEY" }
  ],
  "item": [
