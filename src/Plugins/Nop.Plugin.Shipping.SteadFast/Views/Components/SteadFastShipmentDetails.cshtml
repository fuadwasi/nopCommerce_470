@model dynamic

@if (Model != null)
{
    <div class="btn-group">
        <button type="button" class="btn btn-info" onclick="showSteadFastLogs(@Model.ShipmentId)">
            <i class="fas fa-list"></i> SteadFast Logs
        </button>
        @if (!Model.IsSent)
        {
            <button type="button" class="btn btn-primary" onclick="showSteadFastShipmentForm(@Model.ShipmentId)">
                <i class="fas fa-shipping-fast"></i> Create SteadFast Shipment
            </button>
        }
    </div>
}

<script>
    function showSteadFastLogs(shipmentId) {
        $.ajax({
            url: '@Url.Action("GetShipmentEventLogs", "SteadFast")',
            type: 'GET',
            data: { shipmentId: shipmentId },
            success: function (response) {
                if (response.success) {
                    var logsHtml = '<div class="table-responsive"><table class="table table-striped">';
                    logsHtml += '<thead><tr><th>Date/Time</th><th>Event</th><th>Old Status</th><th>New Status</th><th>Message</th></tr></thead><tbody>';
                    
                    if (response.logs && response.logs.length > 0) {
                        response.logs.forEach(function (log) {
                            logsHtml += '<tr>';
                            logsHtml += '<td>' + log.createdOn + '</td>';
                            logsHtml += '<td>' + log.eventType + '</td>';
                            logsHtml += '<td>' + log.oldStatus + '</td>';
                            logsHtml += '<td>' + log.newStatus + '</td>';
                            logsHtml += '<td>' + log.statusMessage + '</td>';
                            logsHtml += '</tr>';
                        });
                    } else {
                        logsHtml += '<tr><td colspan="5" class="text-center">No logs found</td></tr>';
                    }
                    
                    logsHtml += '</tbody></table></div>';
                    
                    if (response.trackingUrl) {
                        logsHtml += '<div class="mt-3"><strong>Tracking URL:</strong> <a href="' + response.trackingUrl + '" target="_blank">' + response.trackingUrl + '</a></div>';
                    }
                    
                    if (response.consignmentId) {
                        logsHtml += '<div class="mt-2"><strong>Consignment ID:</strong> ' + response.consignmentId + '</div>';
                    }
                    
                    // Show in modal
                    $('<div>').html(logsHtml).dialog({
                        title: 'SteadFast Shipment Logs',
                        modal: true,
                        width: 800,
                        buttons: {
                            "Close": function () {
                                $(this).dialog("close");
                            }
                        }
                    });
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function () {
                alert('Failed to fetch shipment logs');
            }
        });
    }

    function showSteadFastShipmentForm(shipmentId) {
        // First, get shipment info
        $.ajax({
            url: '@Url.Action("GetShipmentInfo", "SteadFast")',
            type: 'GET',
            data: { shipmentId: shipmentId },
            success: function (response) {
                if (response.success) {
                    var formHtml = '<form id="steadfast-shipment-form">';
                    formHtml += '<div class="form-group">';
                    formHtml += '<label>Recipient Name</label>';
                    formHtml += '<input type="text" class="form-control" id="sf-recipient-name" value="' + response.recipientName + '" required />';
                    formHtml += '</div>';
                    formHtml += '<div class="form-group">';
                    formHtml += '<label>Recipient Phone</label>';
                    formHtml += '<input type="text" class="form-control" id="sf-recipient-phone" value="' + response.recipientPhone + '" required />';
                    formHtml += '</div>';
                    formHtml += '<div class="form-group">';
                    formHtml += '<label>Recipient Address</label>';
                    formHtml += '<textarea class="form-control" id="sf-recipient-address" rows="3" required>' + response.recipientAddress + '</textarea>';
                    formHtml += '</div>';
                    formHtml += '<div class="form-group">';
                    formHtml += '<label>COD Amount</label>';
                    formHtml += '<input type="number" step="0.01" class="form-control" id="sf-cod-amount" value="' + response.codAmount + '" required />';
                    formHtml += '</div>';
                    formHtml += '</form>';
                    
                    $('<div>').html(formHtml).dialog({
                        title: 'Create SteadFast Shipment',
                        modal: true,
                        width: 500,
                        buttons: {
                            "Create": function () {
                                var dialog = $(this);
                                createSteadFastShipment(shipmentId, dialog);
                            },
                            "Cancel": function () {
                                $(this).dialog("close");
                            }
                        }
                    });
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function () {
                alert('Failed to fetch shipment info');
            }
        });
    }

    function createSteadFastShipment(shipmentId, dialog) {
        var postData = {
                shipmentId: shipmentId,
                recipientName: $('#sf-recipient-name').val(),
                recipientPhone: $('#sf-recipient-phone').val(),
                recipientAddress: $('#sf-recipient-address').val(),
                codAmount: $('#sf-cod-amount').val()
            };
            addAntiForgeryToken(postData);

        $.ajax({
            url: '@Url.Action("CreateShipmentManual", "SteadFast")',
            type: 'POST',
            data: postData,
            success: function (response) {
                if (response.success) {
                    alert('Shipment created successfully! Consignment ID: ' + response.consignmentId);
                    dialog.dialog("close");
                    location.reload();
                } else {
                    alert('Error: ' + response.message);
                }
            },
            error: function () {
                alert('Failed to create shipment');
            }
        });
    }
</script>
